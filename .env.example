# Copy this file to .env and fill it in. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:8000

# PostgreSQL (format: postgres://USER:PASSWORD@HOST:PORT/DBNAME)
DATABASE_URL=postgres://tannery:change-me@localhost:5432/tannery_desk

# Razorpay. Empty keys use the SANDBOX only in development (DEBUG=True); production requires both keys.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Share of the order total paid up front (percent)
ADVANCE_PERCENT=30

# Email for password reset. The default prints emails in the server console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Tannery Desk <no-reply@example.com>
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# Production only
# CORS_ALLOWED_ORIGINS=https://your-domain.com
# CSRF_TRUSTED_ORIGINS=https://your-domain.com
# BEHIND_PROXY=True
# MAX_UPLOAD_MB=10
